[Unit]
Description=APEX read-only shadow capture and model observation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=apex-shadow
Group=apex-shadow
WorkingDirectory=@@RELEASE@@
ExecStart=@@RELEASE@@/venv/bin/apex shadow-tick --root /var/lib/apex-shadow --settings /etc/apex-shadow/settings.json
LoadCredential=alpaca_key:/etc/apex-shadow/credentials/alpaca_key
LoadCredential=alpaca_secret:/etc/apex-shadow/credentials/alpaca_secret
StateDirectory=apex-shadow
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=90
TimeoutStopSec=5
KillMode=control-group
MemoryMax=1G
TasksMax=64
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
