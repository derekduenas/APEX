[Unit]
Description=APEX simulated paper account and position servicing
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=apex-paper
Group=apex-paper
SupplementaryGroups=apex-paper-feed
WorkingDirectory=@@RELEASE@@
ExecStart=@@RELEASE@@/venv/bin/apex paper-service-tick --root /var/lib/apex-paper --generation /var/lib/apex-paper-feed --settings /etc/apex-paper/settings.json
StateDirectory=apex-paper
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45
TimeoutStopSec=5
KillMode=control-group
MemoryMax=1G
TasksMax=64
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
